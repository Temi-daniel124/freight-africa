 "notes": {
  "s1": {
   "x": 3880,
   "y": 0,
   "w": 460,
   "fill": "green",
   "page": "d-trip",
   "text": "Driving rules: 17 px body, 26\u201334 px titles, one 68 px main button above the tab bar, big icon buttons, SOS (hold 2 s) on every live step, dark screen at night after sunset (DV17). No money anywhere. The driver never holds a code: Chidi (loading) and Ibrahim (receiver) give them. The driver can call the pickup and receiver contacts on a live trip; the owner is reached by message (no phone number shown). Live chat comes in Launch 2. Typing is disabled while moving; voice notes still work."
  },
  "t-d-desktop": {
   "x": 0,
   "y": -300,
   "text": "Driver \u00b7 Desktop (view only)",
   "kind": "title1",
   "maxW": 2960,
   "page": "d-desktop"
  },
  "t-d-other": {
   "x": 0,
