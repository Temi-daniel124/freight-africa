  "t-d-trouble": {
   "x": 0,
   "y": -300,
   "text": "Driver \u00b7 Phone \u00b7 problems and safety",
   "kind": "title1",
   "maxW": 1800,
   "page": "d-trouble"
  },
  "n-install": {
   "x": 1880,
   "y": 1960,
   "text": "Installed = the app is actually running from the home screen on this phone (display-mode: standalone, or navigator.standalone on iPhone), and that installed app has checked in with our server. Tapping Install, or the browser saying 'accepted', only moves to Waiting. Network drop or cancel \u2192 Not installed yet. The iPhone home-screen app starts with no sign-in, so it asks for the one-time setup code.",
   "page": "d-setup",
   "w": 860,
   "fill": "green"
  },
  "n-msg": {
   "x": 2350,
   "y": 1320,
   "text": "Drivers never see the owner's phone number. Message, not call: one message plus an optional voice note, delivered to the owner's app. Replies arrive in Notifications; they aren't instant. This is not live chat (still Launch 2). Emergencies on a trip use SOS.",
   "page": "d-other",
   "w": 420,
   "fill": "green"
  }
 },
